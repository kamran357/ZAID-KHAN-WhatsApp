# ---- server (apps/server) ----
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# SQLite file, relative to apps/server
DATABASE_URL=file:./data/zaidkhan.db

# Dashboard login. Change this before exposing the app to the internet.
AUTH_PASSWORD=zaidkhan

# 32-byte base64 key used to encrypt the Groq API key at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If empty, a key is derived from AUTH_PASSWORD (fine locally, set it for production).
APP_ENCRYPTION_KEY=

# Optional: seed the Groq key at boot. The dashboard stores it encrypted instead,
# so leave this empty unless you want a headless install.
GROQ_API_KEY=

# ---- web (apps/web) ----
# Server-side proxy target for /api and /socket.io (defaults to http://localhost:4000)
API_PROXY_TARGET=http://localhost:4000
